<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_insa_city_list" model="ir.ui.view">
        <field name="name">insa.city.list</field>
        <field name="model">insa.city</field>
        <field name="arch" type="xml">
            <list string="Ciudades / Barrios" editable="bottom">
                <field name="name"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_insa_city" model="ir.actions.act_window">
        <field name="name">Ciudades / Barrios</field>
        <field name="res_model">insa.city</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Cuelga de menu_reparto_root (menu_reparto.xml) — insa_reparto ya
         tiene su propio menú raíz, no hace falta uno nuevo para esto. -->
    <menuitem id="menu_reparto_config" name="Configuración"
              parent="menu_reparto_root"
              groups="insa_reparto.group_supervisor"
              sequence="70"/>
    <menuitem id="menu_insa_city" name="Ciudades / Barrios"
              parent="menu_reparto_config"
              action="action_insa_city"
              sequence="10"/>

</odoo>
