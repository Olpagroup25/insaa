<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="insa_ajuste_inventario_list" model="ir.ui.view">
        <field name="name">insa.ajuste.inventario.list</field>
        <field name="model">insa.ajuste.inventario</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" decoration-muted="not stock_move_id">
                <field name="fecha"/>
                <field name="hoja_ruta_id"/>
                <field name="tipo" widget="badge"
                       decoration-info="tipo == 'articulo'"
                       decoration-warning="tipo == 'envase'"/>
                <field name="product_id"/>
                <field name="diferencia"/>
                <field name="usuario_id"/>
                <field name="motivo"/>
                <field name="stock_move_id"/>
            </list>
        </field>
    </record>

    <record id="action_insa_ajuste_inventario" model="ir.actions.act_window">
        <field name="name">Ajustes de inventario por cierre forzado</field>
        <field name="res_model">insa.ajuste.inventario</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
