<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 4.6 (revisión 29/09): pantalla aparte para ver deudores/quienes
         devolvieron de más, cruzando todos los clientes — la lista
         embebida en el contacto solo muestra la de un cliente a la vez. -->
    <record id="insa_saldo_envase_list" model="ir.ui.view">
        <field name="name">insa.saldo.envase.list</field>
        <field name="model">insa.saldo.envase</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="saldo"/>
                <field name="permitido"/>
                <field name="cantidad_a_recuperar"/>
                <field name="estado_saldo" widget="badge"
                       decoration-danger="estado_saldo == 'debe'"
                       decoration-info="estado_saldo == 'a_favor'"
                       decoration-success="estado_saldo == 'al_dia'"/>
            </list>
        </field>
    </record>

    <record id="insa_saldo_envase_search" model="ir.ui.view">
        <field name="name">insa.saldo.envase.search</field>
        <field name="model">insa.saldo.envase</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="product_id"/>
                <filter string="Deudores de envases" name="deudores" domain="[('estado_saldo', '=', 'debe')]"/>
                <filter string="Devolvieron envases" name="a_favor" domain="[('estado_saldo', '=', 'a_favor')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Producto retornable" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Estado" name="group_estado" context="{'group_by': 'estado_saldo'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_insa_saldo_envase" model="ir.actions.act_window">
        <field name="name">Saldo de envases</field>
        <field name="res_model">insa.saldo.envase</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="insa_saldo_envase_search"/>
        <field name="context">{'search_default_deudores': 1}</field>
    </record>
</odoo>
