<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- R-08 (reunión 14/09): "Clientes por reparto: hoy muestra activos y
         bajas. Mantener todos, pero agregar filtro 'Solo activos'" —
         puesto por defecto (se quita con un click para ver las bajas). -->
    <record id="fsm_location_search_view_insa" model="ir.ui.view">
        <field name="name">fsm.location.search.insa</field>
        <field name="model">fsm.location</field>
        <field name="inherit_id" ref="fieldservice.fsm_location_search_view"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="before">
                <field name="fsm_route_id"/>
                <filter string="Solo activos" name="solo_activos"
                        domain="[('x_insa_estado_ws', 'in', [False, 'activo'])]"/>
                <separator/>
            </field>
            <filter name="owner_id" position="after">
                <filter string="Reparto" name="group_fsm_route" context="{'group_by': 'fsm_route_id'}"/>
                <filter string="Estado" name="group_estado_ws" context="{'group_by': 'x_insa_estado_ws'}"/>
            </filter>
        </field>
    </record>

    <record id="action_insa_clientes_reparto" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="res_model">fsm.location</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="fieldservice.fsm_location_list_view"/>
        <field name="search_view_id" ref="fieldservice.fsm_location_search_view"/>
        <field name="context">{'search_default_solo_activos': 1}</field>
    </record>
</odoo>
